<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OnVoiceComBridge</AssemblyName>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <UseWindowsSdkPackage>true</UseWindowsSdkPackage>
    
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ApplicationManifest>OnVoiceComBridge.exe.manifest</ApplicationManifest>
    <!-- Self-contained 빌드 시 네이티브 라이브러리 포함 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Visual C++ 런타임 포함 -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <None Include="OnVoiceComBridge.exe.manifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- OnVoiceAudioBridge.dll을 publish 폴더로 복사 (매니페스트 파일에서 참조) -->
    <Content Include="..\..\native\OnVoiceAudioBridge.dll" Condition="Exists('..\..\native\OnVoiceAudioBridge.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>OnVoiceAudioBridge.dll</Link>
    </Content>
    <!-- OnVoiceAudioBridge.dll.manifest도 복사 (Registration-Free COM) -->
    <Content Include="..\..\native\OnVoiceAudioBridge.dll.manifest" Condition="Exists('..\..\native\OnVoiceAudioBridge.dll.manifest')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>OnVoiceAudioBridge.dll.manifest</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
    <PackageReference Include="System.Text.Json" Version="6.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>