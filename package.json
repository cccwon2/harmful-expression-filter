{
  "name": "harmful-expression-filter",
  "version": "1.0.0",
  "description": "OnVoice - Voice Overlay Application",
  "main": "./dist-electron/main.js",
  "scripts": {
    "build:dotnet": "cd dotnet/OnVoiceComBridge && dotnet build",
    "copy:dll": "node scripts/copy-dll.js",
    "build:native": "node scripts/build-native.js",
    "copy:native": "node scripts/copy-native-dll.js",
    "build:main": "tsc -p electron/tsconfig.json",
    "build:all": "npm run build:dotnet && npm run build:native && npm run copy:dll && npm run copy:native && npm run build:main",
    "dev:main": "tsc -w -p electron/tsconfig.json",
    "dev:renderer": "vite",
    "dev": "cross-env EDGE_USE_CORECLR=1 concurrently -k \"npm:dev:main\" \"npm:dev:renderer\" \"electron .\"",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_ENV=production DOTNET_ROOT=\"C:\\Program Files\\dotnet\" EDGE_USE_CORECLR=1 electron .",
    "build:renderer": "vite build",
    "build:electron": "electron-builder",
    "build": "npm run build:all && npm run build:renderer && npm run build:electron",
    "build:win": "npm run build",
    "postinstall": "electron-rebuild -f || echo 'Rebuild skipped'"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "overlay",
    "roi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@deepgram/sdk": "^4.11.2",
    "@huggingface/transformers": "^3.0.0",
    "axios": "^1.13.2",
    "dotenv": "^16.3.1",
    "electron-edge-js": "^28.0.0",
    "form-data": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/ws": "^8.5.8",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.5"
  },
  "build": {
    "productName": "OnVoice",
    "appId": "com.onvoice.app",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "extraResources": [
      {
        "from": "dotnet/OnVoiceComBridge/bin/Debug/net6.0",
        "to": "dotnet",
        "filter": [
          "**/*.dll",
          "**/*.json"
        ]
      }
    ]
  }
}
