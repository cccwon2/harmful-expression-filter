{
  "name": "harmful-expression-filter",
  "version": "1.0.0",
  "description": "OnVoice - Voice Overlay Application",
  "main": "./dist-electron/main.js",
  "scripts": {
    "build:dotnet": "cd dotnet/OnVoiceComBridge && dotnet publish --configuration Release --runtime win-x64 --self-contained true -p:PublishSingleFile=false --output bin/Publish",
    "copy:dll": "node scripts/copy-dll.js",
    "build:native": "node scripts/build-native.js",
    "copy:native": "node scripts/copy-native-dll.js",
    "build:main": "tsc -p electron/tsconfig.json",
    "build:all": "npm run build:dotnet && npm run build:native && npm run copy:dll && npm run copy:native && npm run build:main",
    "dev:main": "tsc -w -p electron/tsconfig.json",
    "dev:renderer": "vite",
    "dev": "cross-env EDGE_USE_CORECLR=1 concurrently -k \"npm:dev:main\" \"npm:dev:renderer\" \"electron .\"",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_ENV=production DOTNET_ROOT=\"C:\\Program Files\\dotnet\" EDGE_USE_CORECLR=1 electron .",
    "build:renderer": "vite build",
    "rebuild": "electron-rebuild -f -w electron-edge-js",
    "prebuild:electron": "npm run rebuild && npm run copy:native",
    "build:electron": "npm run prebuild:electron && electron-builder",
    "build": "npm run build:all && npm run build:renderer && npm run build:electron",
    "build:win": "npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "overlay",
    "roi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^16.3.1",
    "electron-edge-js": "^28.0.0",
    "form-data": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/ws": "^8.5.8",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.5"
  },
  "build": {
    "productName": "OnVoice",
    "appId": "com.onvoice.app",
    "asar": true,
    "asarUnpack": [
      "node_modules/electron-edge-js/lib/native/**/*",
      "node_modules/electron-edge-js/lib/bootstrap/**/*",
      "node_modules/electron-edge-js/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "files": [
      "dist-electron/**/*",
      "!dist-electron/dotnet/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!server/**/*",
      "!dotnet/**/*",
      "!native/**/*",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!vite.config.ts",
      "!**/node_modules/sharp/vendor/**/linux-x64/**/*",
      "!**/node_modules/sharp/vendor/**/darwin-x64/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/electron-edge-js/lib/bootstrap",
        "to": "bootstrap",
        "filter": ["**/*"]
      },
      {
        "from": "dotnet/OnVoiceComBridge/bin/Publish",
        "to": "dotnet",
        "filter": [
          "**/*",
          "!**/*.pdb"
        ]
      },
      {
        "from": ".env.production",
        "to": ".env"
      },
      {
        "from": "native/OnVoiceAudioBridge.dll",
        "to": "native",
        "filter": [
          "*.dll"
        ]
      }
    ]
  }
}