{
  "name": "harmful-expression-filter",
  "version": "1.0.0",
  "description": "OnVoice - Voice Overlay Application",
  "main": "./dist-electron/main.js",
  "scripts": {
    "build:dotnet": "cd dotnet/OnVoiceComBridge && dotnet build",
    "copy:dll": "node scripts/copy-dll.js",
    "build:main": "tsc -p electron/tsconfig.json",
    "build:all": "npm run build:dotnet && npm run copy:dll && npm run build:main",
    "dev:main": "tsc -w -p electron/tsconfig.json",
    "dev:renderer": "vite",
    "dev": "cross-env EDGE_USE_CORECLR=1 concurrently -k \"npm:dev:main\" \"npm:dev:renderer\" \"electron .\"",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_ENV=production DOTNET_ROOT=\"C:\\Program Files\\dotnet\" EDGE_USE_CORECLR=1 electron .",
    "postinstall": "electron-rebuild -f --only native-sound-mixer || echo 'Rebuild skipped'",
    "rebuild": "electron-rebuild -f --only native-sound-mixer"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "overlay",
    "roi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^16.3.1",
    "electron-edge-js": "^37.0.0",
    "form-data": "^4.0.0",
    "native-sound-mixer": "^3.4.6-win",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/ws": "^8.5.8",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^37.10.2",
    "electron-builder": "^26.0.12",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.5"
  }
}
